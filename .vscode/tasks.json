{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Setup: install requirements",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "pip", "install", "-r", "requirements.txt"],
      "problemMatcher": []
    },
    {
      "label": "Run tests",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "unittest", "discover", "-s", "tests", "-t", ".", "-v"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
